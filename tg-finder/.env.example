# --- Бот (управление) -------------------------------------------------------
# новый бот от @BotFather
FINDER_BOT_TOKEN=123456789:AA...
# твой user id — управление только для тебя
FINDER_ADMIN_ID=8828367482

# --- User-аккаунт для поиска (MTProto) -------------------------------------
# https://my.telegram.org -> API development tools -> api_id / api_hash
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+79261234567

# Сколько результатов просить у Telegram за запрос (макс ~100)
SEARCH_LIMIT=100
# Пауза между запросами инфы о чате, сек (0.5 безопасно)
REQUEST_DELAY=0.5
