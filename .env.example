# Скопируй в .env: cp .env.example .env
BOT_TOKEN=123456789:AA...
ADMIN_ID=123456789

# 1 — браузер без окна (сервер/Termux), 0 — с окном (нужен X11)
HEADLESS=1

# Путь к системному chromium. На Termux: BROWSER_EXECUTABLE=/data/data/com.termux/files/usr/bin/chromium
# Пусто — используется браузер, установленный через `playwright install chromium`.
BROWSER_EXECUTABLE=

# Таймауты
NAV_TIMEOUT=60000
ACTION_TIMEOUT=8000

# Сколько секунд ждать ответа администратора по капче
CAPTCHA_TIMEOUT=300

# Прокси для всех аккаунтов (можно переопределить в accounts.json полем "proxy")
PROXY=

# Сколько карточек видео собирать за один поиск (скролл)
SEARCH_SCAN_LIMIT=120

# Прокси только для регистрации (TikTok режет по IP)
REG_PROXY=

# --- Почта по IMAP: бот сам чеканит адреса и читает код --------------------
# Gmail: включи 2FA -> пароли приложений -> 16-символьный пароль.
# Yandex: пароль приложения. Hotmail не подойдёт (Microsoft требует OAuth2).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# plus = user+tt01@gmail.com, subdomain = tt01@свой-домен (catch-all на этот ящик)
EMAIL_MODE=plus
EMAIL_DOMAIN=
ALIAS_PREFIX=tt
